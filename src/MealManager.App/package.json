{
  "name": "mealmanager",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration=mock",
    "build": "ng build",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "i18n:extract": "ng extract-i18n --format=json --output-path=src/locale --out-file=messages.en-GB.json",
    "i18n:check": "node scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:reuse": "node e2e/run-reuse.mjs",
    "test:e2e:install": "playwright install chromium",
    "e2e:up": "node e2e/serve.mjs",
    "e2e:down": "node e2e/serve.mjs --down"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/localize": "22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@tailwindcss/postcss": "^4.2.2",
    "luxon": "^3.7.2",
    "postcss": "^8.5.8",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@playwright/test": "^1.57.0",
    "@types/luxon": "^3.7.1",
    "daisyui": "^5.5.19",
    "jsdom": "^28.0.0",
    "msw": "^2.14.6",
    "prettier": "^3.8.1",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
